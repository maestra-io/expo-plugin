{
  "expo": {
    "name": "Maestra SDK Expo Example",
    "slug": "example-expo-plugin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.maestra.example.expo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "googleServicesFile": "./credentials/google-services.json",
      "package": "io.maestra.example.expo"
    },
    "plugins": [
      [
        "mindbox-expo-plugin",
        {
          "androidPushProviders": [
            "firebase"
          ],
          "googleServicesFilePath": "./credentials/google-services.json",
          "androidChannelId": "expo_channel_id",
          "androidChannelName": "expo_name",
          "androidChannelDescription": "expo_description",
          "smallIcon": "./assets/icon_mb.png",
          "smallIconAccentColor": "#5DA600",
          "iosMode": "production",
          "usedExpoNotification": true
        }
      ],
      [
        "expo-notifications"
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ]
  }
}
